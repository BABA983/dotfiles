theme = "Flexoki Dark"

font-family = "JetBrains Maple Mono"
font-size = 14

#adjust-cell-height = 35%

background-blur = 40
background-opacity = 0.85

macos-icon = blueprint
macos-titlebar-style = tabs
macos-window-buttons = hidden
macos-option-as-alt = true
macos-auto-secure-input = true
macos-secure-input-indication = true

window-padding-balance = true

quick-terminal-animation-duration = 0
quick-terminal-position = center
quick-terminal-screen = macos-menu-bar
quick-terminal-size = 66%,66%
#keybind = global:cmd+escape=toggle_quick_terminal

#custom-shader = ~/dotfiles/ghostty/shaders/starfield.glsl
#custom-shader-animation = true
